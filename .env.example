# Copy this file to `.env` and fill in real keys. `.env` is gitignored.
# Values already exported in the shell take precedence over anything here.

# ---- Gemini via OpenAI-compat proxy (gemini-3-pro-preview, gemini-2.5-flash) ----
GEMINI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_ENDPOINT=https://api.example.com

# ---- OpenAI-compatible endpoints (gpt-4o, etc.) ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Claude Sonnet (claude-sonnet-4-6) ----
# Default endpoint = OpenAI-compat proxy via /v1/chat/completions (OpenAI-compat).
# Set CLAUDE_ENDPOINT=https://api.anthropic.com to hit Anthropic native
# /v1/messages instead — the wrapper auto-detects from the host.
# ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL are accepted as aliases.
CLAUDE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_ENDPOINT=https://api.example.com

# ---- Google Cloud native Gemini (only if you bypass the proxy) ----
# GCP_API_KEY=
